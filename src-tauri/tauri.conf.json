{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Chronos Engine",
  "version": "0.1.0",
  "identifier": "com.chronos.app",
  "build": {
    "frontendDist": "../src/frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File scripts/release/build_tauri_sidecar.ps1"
  },
  "app": {
    "windows": [
      {
        "title": "Chronos Engine",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8775 http://127.0.0.1:8775 http://localhost:5173 ws://localhost:8775 ws://127.0.0.1:8775 ws://localhost:5173; img-src 'self' data: http://localhost:8775 http://127.0.0.1:8775 http://localhost:5173; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/chronos"],
    "resources": {
      "resources/": ""
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
