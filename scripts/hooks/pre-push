#!/bin/sh
# Git pre-push hook - 全量回归测试
#
# 版本管理的 hook：通过 `git config core.hooksPath scripts/hooks` 启用
# （见 scripts/hooks/install.sh）。修改此文件即修改全仓的推送门禁。
#
# commit 门禁（scripts/hooks/pre-commit）只跑 lint/类型检查 + testmon 增量测试；
# 全量 `pytest tests/` 挪到这里，在真正把改动推给别人看之前兜底。

echo "=================================================="
echo "🚀 [Git Pre-push Hook] 开始执行全量回归测试..."
echo "=================================================="

if [ -f "./.venv/Scripts/pytest.exe" ]; then
    PYTEST_CMD="./.venv/Scripts/pytest.exe"
elif [ -f "./.venv/bin/pytest" ]; then
    PYTEST_CMD="./.venv/bin/pytest"
else
    PYTEST_CMD="pytest"
fi

echo "使用命令: $PYTEST_CMD tests/"
$PYTEST_CMD tests/

RESULT=$?

if [ $RESULT -ne 0 ]; then
    echo ""
    echo "❌ 全量测试未通过！推送已中断。"
    echo "请修复错误后再尝试 push。"
    echo "=================================================="
    exit 1
fi

echo ""
echo "✅ 全量回归测试通过。允许推送。"
echo "=================================================="
exit 0
